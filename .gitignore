# ============================================================
# 华农心晴导航 - Git 忽略规则
# ============================================================

# ---------- 密钥 / 本地配置（绝不入库） ----------
config/.env
*.local
# gh CLI 本地配置（含访问令牌，放进项目内以绕过沙盒限制）
.ghconfig/

# ---------- 体积巨大的安装包 / 压缩包（勿入库，仓库会炸） ----------
*.exe
*.msi
*.msixbundle
*.zip
*.7z

# ---------- 第三方源码（Dify 官方仓库，按需自行 clone） ----------
docker/dify/

# ---------- 运行日志 ----------
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------- Node / Electron ----------
node_modules/
dist/
out/
*.asar

# ---------- IDE / 编辑器 ----------
.idea/
*.swp
*.swo

# ---------- 操作系统 ----------
Thumbs.db
desktop.ini
.DS_Store
