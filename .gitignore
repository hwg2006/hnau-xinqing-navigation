# ============================================================
# 华农心晴导航 - Git 忽略规则
# ============================================================

# ---------- 密钥 / 本地配置（绝不入库） ----------
config/.env
*.local
# gh CLI 凭据已迁移至用户级默认目录（%APPDATA%\GitHub CLI），不再随项目存放。
# 保留以下防御性规则，防止凭据目录被误提交入库。
.ghconfig/

# ---------- 体积巨大的安装包 / 压缩包（勿入库，仓库会炸） ----------
*.exe
*.msi
*.msixbundle
*.zip
*.7z

# ---------- 第三方源码（Dify 官方仓库，按需自行 clone） ----------
docker/dify/

# ---------- 运行日志 ----------
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------- Node / Electron ----------
node_modules/
dist/
out/
*.asar
# electron-builder 打包产物（含安装包与 win-unpacked）
desktop/release/

# ---------- IDE / 编辑器 ----------
.idea/
*.swp
*.swo

# ---------- 操作系统 ----------
Thumbs.db
desktop.ini
.DS_Store
