{
  "name": "xinqiang-nav-desktop",
  "version": "1.0.0",
  "description": "华农心晴导航 - 桌面版 (Electron)",
  "main": "main.js",
  "author": "华农心晴团队",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build-win": "electron-builder --win --x64",
    "build-mac": "electron-builder --mac",
    "build-all": "electron-builder -mw"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hnau.xinqiang",
    "productName": "华农心晴导航",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "../web/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "华农心晴导航"
    }
  }
}
