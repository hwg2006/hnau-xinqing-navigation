# ============================================================
# 华农心晴导航 - 全局配置模板
# 使用方法：复制此文件为 .env 并填入你的实际值
# ============================================================

# ---------- Ollama 本地模型服务 ----------
# Ollama 默认地址（本地部署无需修改）
OLLAMA_BASE_URL=http://localhost:11434
# 本地模型名称（ollama pull 下载的模型名）
OLLAMA_MODEL=qwen2.5:7b

# ---------- Dify 智能体平台 ----------
# Dify 本地部署地址（Docker Desktop 起的）
DIFY_BASE_URL=http://localhost
# Dify App API Key（在 Dify 应用控制台 → 访问点 → API 密钥 创建）
# 注意：此 Key 只保存在服务端，切勿写入前端代码（Web 走 server/dify_proxy.py 代理）
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# Web 后端代理端口（server/dify_proxy.py），需与 web/config.js 的 apiBaseUrl 一致
DIFY_PROXY_PORT=8001
